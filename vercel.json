{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,portal.html,gate.html,super-admin.html,manifest.webmanifest,sw.js,css/**,js/**,assets/**,features/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
