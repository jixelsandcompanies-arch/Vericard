{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "portal.html",
          "gate.html",
          "super-admin.html",
          "manifest.webmanifest",
          "sw.js",
          "css/**",
          "js/**",
          "assets/**",
          "features/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
